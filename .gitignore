node_modules/
dist/
.env
*.log
.claude/

# Personal customisation (your own goals, stats, dietary prefs). Keep this private.
PERSONAL.md

# User-dumped training programs / knowledge. Ingested into Notion, never committed.
knowledge/*
!knowledge/README.md
!knowledge/.gitkeep

# Your Notion Hub page pin (points at your private workspace). Copy from the .example.
config/notion-hub.json

# Internal planning scratch notes, never shipped
docs/*-plan.md
docs/ideas/

# Runtime data: persisted sessions and scheduled tasks
data/
*-sessions.json
*-schedule.json

# Local caches written by skills/scripts at runtime
**/.cache/

# Terraform state and secret var files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Azure deployment parameters (hold secrets)
infra/azure/main.parameters.json
