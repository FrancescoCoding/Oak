# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars (it holds secrets).

project_id = "your-gcp-project"
region     = "europe-west1"

allowed_telegram_ids = "YOUR_TELEGRAM_ID"
owner_chat_id        = "YOUR_TELEGRAM_ID"
timezone             = "Europe/London"
agent_name           = "Coach"

# Optional Notion. Leave notion_token empty to run without persistence.
notion_token          = ""
notion_parent_page_id = ""

# Secrets (stored in Secret Manager by Terraform).
claude_oauth_token = "PASTE_FROM_claude_setup-token"
telegram_bot_token = "PASTE_FROM_BotFather"
cron_secret        = "GENERATE_A_LONG_RANDOM_VALUE"

# personalities_enabled defaults to false; set true to enable persona overlays.
# personalities_enabled = true
# owner_persona         = "arnold"

# Optional model override.
# claude_model = "claude-sonnet-5"

# Voice notes on scale-to-zero: API transcription (local Whisper would need a big instance).
# Leave transcribe_api_key empty to disable voice notes.
# transcribe_api_key = "sk-..."

# Optional Google Calendar sync (see docs/google-calendar-architecture.md).
# Run `node --env-file=.env scripts/google-auth.mjs` locally first to get the refresh token.
# google_client_id     = "1234-abc.apps.googleusercontent.com"
# google_client_secret = "GOCSPX-..."
# google_refresh_token = "1//..."
