{
  // Type-check only. These files run directly under Node's built-in type
  // stripping (no build step), so they must stick to erasable syntax and use
  // explicit `.ts` extensions on relative imports.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": []
}
