    "croner": "^10.0.1",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
